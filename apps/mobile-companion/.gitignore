# node_modules is intentionally NOT listed here. Rationale:
# (1) npm must see that a node_modules/ folder exists inside the git repo, otherwise it
#     installs lazily into a parent folder outside the repo;
#     (2) the repo root .gitignore already ignores `node_modules/` at any depth.
# Do not add `node_modules/` to this file.

# Expo
.expo/
dist/
web-build/
artifacts/

# Native (generated by prebuild)
/android
/ios
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.kotlin/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# local env files — never committed (may hold credentials)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
