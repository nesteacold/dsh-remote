{
  "expo": {
    "name": "DSH Companion",
    "slug": "dsh-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dshcompanion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dshext.companion",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "DSH Companion uses the camera only to scan the pairing QR code shown on your computer.",
        "NSFaceIDUsageDescription": "DSH Companion uses Face ID to unlock so your paired credential stays protected.",
        "CFBundleDevelopmentRegion": "vi",
        "CFBundleLocalizations": [
          "vi",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dshext.companion",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DSH Companion to scan the pairing QR code shown on your computer."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DSH Companion to unlock with Face ID so your paired credential stays protected."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "./plugins/withPinnedWsConfig",
        {
          "locales": [
            "en",
            "vi"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "autolinkingModuleResolution": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1352584f-32b4-4f00-9852-664315751e64"
      }
    },
    "owner": "nesteacolds-team"
  }
}
