{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "default"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_PUBLIC_DSH_DEBUG_LOG": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_PUBLIC_DSH_DEBUG_LOG": "0"
      }
    },
    "diagnostic": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_PUBLIC_DSH_DEBUG_LOG": "1"
      }
    },
    "release-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "default"
      },
      "env": {
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_PUBLIC_DSH_DEBUG_LOG": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
